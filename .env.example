# ── API Provider ──────────────────────────────────────────
# "anthropic" (default) or "openrouter"
AUTONOVEL_API_PROVIDER=anthropic

# ── API Keys ──────────────────────────────────────────────
# Anthropic API key (required if provider=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key (required if provider=openrouter)
OPENROUTER_API_KEY=sk-or-...

# ── Model Configuration (3 roles) ────────────────────────
# Set these to any model ID your provider supports.
# Anthropic examples: claude-sonnet-4-6, claude-opus-4-6
# OpenRouter examples: anthropic/claude-sonnet-4-6, google/gemini-2.5-pro
AUTONOVEL_WRITER_MODEL=claude-sonnet-4-6
AUTONOVEL_JUDGE_MODEL=claude-opus-4-6
AUTONOVEL_REVIEW_MODEL=claude-opus-4-6

# ── API Base URLs ─────────────────────────────────────────
AUTONOVEL_API_BASE_URL=https://api.anthropic.com
OPENROUTER_BASE_URL=https://openrouter.ai
